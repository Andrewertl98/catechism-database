{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Andrewertl98/catechism-database/seasonal-schema.json",
  "title": "Catechesi Seasonal Content File",
  "description": "Schema for a seasonal/<season>.json file: one liturgical season's general topic and daily challenge. Questions use the same shape and the same citation rule as topics/*.json -- every question carries at least one authoritative citation; a Church Father or other saint may supplement, never stand alone.",
  "type": "object",
  "required": [
    "season",
    "theme",
    "anchoredTailLevels",
    "topics",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "season": {
      "type": "string",
      "enum": [
        "advent",
        "christmas",
        "lent",
        "easter"
      ]
    },
    "theme": {
      "type": "object",
      "required": [
        "title",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "summary": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "anchoredTailLevels": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "How many of the challenge's last levels are fixed to the season's last dates (Advent: 8, Dec 17-24)."
    },
    "topics": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/definitions/seasonalTopic"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/question"
      }
    }
  },
  "definitions": {
    "topicSlug": {
      "type": "string",
      "enum": [
        "advent",
        "advent-challenge",
        "christmas",
        "christmas-challenge",
        "lent",
        "lent-challenge",
        "easter",
        "easter-challenge"
      ]
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "topic",
        "level",
        "type",
        "difficultyElo",
        "prompt",
        "explanation",
        "citations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Format: <seasonal-slug>-l<level>-<3-digit-sequence>, e.g. advent-challenge-l12-003.",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-l([1-9]|[1-4][0-9])-[0-9]{3}$"
        },
        "topic": {
          "$ref": "#/definitions/topicSlug",
          "description": "Must match this file's top-level 'topic' field."
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 49,
          "description": "Seasonal challenges run one level per day: Advent up to 28, Christmas 19, Lent 46, Easter 49."
        },
        "type": {
          "type": "string",
          "enum": [
            "multiple_choice",
            "true_false",
            "matching_pairs",
            "fill_blank"
          ]
        },
        "difficultyElo": {
          "type": "integer",
          "minimum": 800,
          "maximum": 2800,
          "description": "Seed Elo difficulty for this question, consumed by EloEngine."
        },
        "prompt": {
          "type": "string",
          "minLength": 10
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 6,
          "description": "Used by multiple_choice only."
        },
        "correctAnswer": {
          "type": [
            "string",
            "boolean"
          ],
          "description": "Used by multiple_choice (string, must match a choice), true_false (boolean), and fill_blank (string). Omitted for matching_pairs, where 'pairs' itself is the answer key."
        },
        "acceptedAnswers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional, fill_blank only. Extra answers graded correct alongside 'correctAnswer'. Grading already ignores case, surrounding whitespace, a single leading article, and trailing sentence punctuation, so list only genuinely different wordings a careful reader might give (e.g. 'Holy Spirit' for 'Paraclete'). Never use it to accept a substantively different answer."
        },
        "pairs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "left",
              "right"
            ],
            "additionalProperties": false,
            "properties": {
              "left": {
                "type": "string"
              },
              "right": {
                "type": "string"
              }
            }
          },
          "description": "Used by matching_pairs only."
        },
        "explanation": {
          "type": "string",
          "minLength": 10,
          "description": "Shown after answering; must stand on its own as a short catechetical note."
        },
        "hint": {
          "type": "string",
          "minLength": 10,
          "description": "Optional. Shown by the in-app guide mascot if the user pauses too long before answering. Falls back to a generic line when absent."
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/citation"
          },
          "contains": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "ccc",
                  "scripture",
                  "council",
                  "magisterial_document",
                  "catechism"
                ]
              }
            }
          },
          "description": "Must contain at least one citation whose type is ccc, scripture, council, magisterial_document, or catechism. A church_father citation may supplement these but can never stand alone."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit_status": {
          "type": "string",
          "enum": [
            "audited",
            "community",
            "pending"
          ],
          "description": "Set to 'audited' only once a credentialed theological reviewer has actually approved this specific question -- see sign_audit_manifest.swift, which reads exactly this field to build manifest.json's signed auditedQuestionIDs list. Omit entirely for unreviewed content; the app and this field both default to 'pending' when absent. Setting this by hand does NOT itself unlock anything in the app -- AuditManifestVerifier only trusts IDs that are also present in manifest.json's cryptographically signed auditedQuestionIDs list, precisely so a stray edit here (or a compromised GitHub account) can't forge an audited claim."
        },
        "contributors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "GitHub handles of contributors, shown on the in-app credits screen. Optional; omitted entirely for most content so far."
        },
        "miniGameEligible": {
          "type": "boolean",
          "enum": [
            false
          ],
          "description": "Seasonal content never feeds the mini-game pools."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "multiple_choice"
              }
            }
          },
          "then": {
            "required": [
              "choices",
              "correctAnswer"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "true_false"
              }
            }
          },
          "then": {
            "required": [
              "correctAnswer"
            ],
            "properties": {
              "correctAnswer": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "matching_pairs"
              }
            }
          },
          "then": {
            "required": [
              "pairs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fill_blank"
              }
            }
          },
          "then": {
            "required": [
              "correctAnswer"
            ],
            "properties": {
              "correctAnswer": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "citation": {
      "type": "object",
      "required": [
        "type",
        "reference"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ccc",
            "scripture",
            "council",
            "magisterial_document",
            "church_father",
            "catechism"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. 'CCC 881', 'Matthew 16:18-19', 'First Council of Nicaea (325)', 'Pius IX, Ineffabilis Deus (1854)', 'St. Augustine of Hippo'"
        },
        "note": {
          "type": "string",
          "description": "Optional short clarifying note about the citation."
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "description": "Optional excerpt of the actual source text this citation points to -- a short, specific passage (e.g. the one sentence of CCC 253 that's relevant), not the full paragraph or chapter. Added Aug 12, 2026; most existing citations don't have one yet."
        }
      }
    },
    "passage": {
      "type": "object",
      "required": [
        "reference",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 3
        },
        "text": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "saintPassage": {
      "type": "object",
      "required": [
        "name",
        "reference",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3
        },
        "reference": {
          "type": "string",
          "minLength": 3
        },
        "text": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "level": {
      "type": "object",
      "required": [
        "level",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 49
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "date": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "description": "Optional, informational: the calendar date an anchored-tail level always falls on (MM-DD)."
        },
        "reflection": {
          "type": "string",
          "minLength": 40,
          "description": "Challenge levels: the short reading that opens the day."
        },
        "scripture": {
          "$ref": "#/definitions/passage"
        },
        "saint": {
          "$ref": "#/definitions/saintPassage"
        }
      }
    },
    "seasonalTopic": {
      "type": "object",
      "required": [
        "slug",
        "kind",
        "name",
        "levels"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "$ref": "#/definitions/topicSlug"
        },
        "kind": {
          "type": "string",
          "enum": [
            "general",
            "challenge"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "summary": {
          "type": "string"
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/level"
          }
        }
      }
    }
  }
}
